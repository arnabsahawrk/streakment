# Neon connection string (pooled)
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# Brevo -> SMTP & API -> API keys
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="arnabsahawrk@gmail.com"
BREVO_SENDER_NAME="Streakment"

# Any long random string; Vercel Cron sends it as a bearer token
CRON_SECRET="replace-me"

# Any long random string; encrypts the app passcode at rest so it can
# be recovered (see "forgot passcode"). Changing this after a passcode
# is already set locks it out permanently, so set it once.
PASSCODE_KEY="replace-me-too"
